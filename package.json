{
  "$schema": "https://json.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=4.0.0"
  },
  "packageManager": "yarn@4.12.0",
  "scripts": {
    "dev": "run-p dev:vite dev:serve",
    "dev:vite": "vite",
    "dev:serve": "php artisan serve",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "clean": "rimraf ./node_modules/.vite",
    "lint": "eslint . --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint && prettier . -w -u",
    "lint:php": "composer pint",
    "lint:style": "stylelint \"./**/*.{css,sass,scss,htm,html,vue}\" --fix --cache-location ./node_modules/.vite/vite-plugin-stylelint  && prettier  \"./**/*.{css,sass,scss,htm,html,vue}\" -w -u",
    "build": "run-p type-check build-only",
    "build:analyze": "vite build --mode analyze",
    "build:clean": "rimraf public/build bootstrap/ssr",
    "build-only": "vite build && vite build --ssr",
    "preview": "vite preview",
    "prepare": "husky install"
  },
  "dependencies": {
    "@inertiajs/inertia": "^0.11.1",
    "@inertiajs/vue2": "^1.3.0",
    "@logue/vue2-helpers": "2.2.1",
    "@tailwindcss/forms": "^0.5.7",
    "axios": "^1.7.2",
    "normalize.css": "^8.0.1",
    "tailwindcss": "^3.4.1",
    "vue": "^2.7.16",
    "vue-inertia-composable": "^0.4.3",
    "ziggy-js": "^1.8.1"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.7.2",
    "@tsconfig/node-lts": "^20.1.0",
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.11.0",
    "@types/ziggy-js": "^1.3.3",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@vitejs/plugin-vue2": "^2.3.1",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-config-standard-with-typescript": "^43.0.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-html": "^7.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-tsdoc": "^0.3.0",
    "eslint-plugin-vue": "latest",
    "eslint-plugin-vuejs-accessibility": "^2.2.1",
    "eslint-plugin-yaml": "^0.5.0",
    "husky": "^9.0.10",
    "laravel-vite-plugin": "^1.0.0",
    "lint-staged": "^15.2.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "postcss-html": "^1.6.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "stylelint": "^16.2.1",
    "stylelint-config-recommended-scss": "^14.0.0",
    "stylelint-config-recommended-vue": "^1.5.0",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.4.2",
    "vite": "^5.2.8",
    "vite-plugin-checker": "^0.6.4",
    "vue-eslint-parser": "^9.4.2",
    "vue-server-renderer": "^2.7.16",
    "vue-tsc": "^2.0.6"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,ts,json,jsonc,json5,yaml,yml,toml,vue,htm,html,md}": "eslint --fix --cache --cache-location ./node_modules/.vite/vite-plugin-eslint",
    "*.{css,sass,scss,vue,htm,html}": "stylelint --fix --cache --cache-location ./node_modules/.vite/vite-plugin-stylelint",
    "*.php": "composer pint",
    "*": "prettier -w -u"
  },
  "resolutions": {
    "http-cache-semantics": "^4.1.1",
    "json5": "^2.2.3",
    "semver": "^7.6.0",
    "yaml": "^2.4.0"
  }
}
